# Copy to .env and fill in real values. Never commit .env.
# JWT secrets must be ≥ 32 characters (bytes) for HMAC-SHA256.

# ── JWT (required in prod) ───────────────────────────────────────────────────
APP_JWT_SECRET_MASTER=replace-with-strong-random-secret-min-32-chars
APP_JWT_SECRET_SESSION=replace-with-strong-random-secret-min-32-chars

# ── CORS / Feign ─────────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://yourfrontend.com
MS_PRACTICA_URL=https://practica-service.internal

# ── PostgreSQL (prod / docker-compose) ───────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/msauth
SPRING_DATASOURCE_USERNAME=msauth
SPRING_DATASOURCE_PASSWORD=replace-with-strong-db-password
POSTGRES_PASSWORD=replace-with-strong-db-password

# ── Runtime ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=
